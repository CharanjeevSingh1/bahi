<?xml version="1.0" encoding="utf-8"?>
<!-- Same book-plus-ruled-lines geometry as ic_launcher_foreground.xml,
     collapsed to one path since the themed-icon system supplies its own
     single tint and ignores fillColor. Spine and cover merge into one
     silhouette, and the three ruled lines stay as evenOdd cutouts so they
     read as gaps against whatever background the system picks. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M35,29 L73,29 L73,79 L35,79 Z
                           M47,39 L67,39 L67,42 L47,42 Z
                           M47,51 L67,51 L67,54 L47,54 Z
                           M47,63 L67,63 L67,66 L47,66 Z" />
</vector>

    <string name="budgets_add_content_description">Add budget</string>
    <string name="budgets_previous_month">Previous month</string>
    <string name="budgets_next_month">Next month</string>
    <string name="budgets_rules_action">Rules</string>
    <string name="budgets_edit">Edit</string>

    <string name="budgets_over_by">%1$s over budget</string>
    <string name="budgets_limit_reached">Limit reached</string>
    <string name="budgets_empty_title">No budgets for this month</string>
    <string name="budgets_empty_body">Set a monthly limit for a category and this screen will track what you\'ve spent against it.</string>
    <!-- Deliberately narrow: spending in a category with no budget is invisible
         here too, so this must not claim the month was empty. -->
    <string name="budgets_nothing_counted">Nothing has been counted against these budgets yet this month.</string>

    <string name="budgets_uncategorised_title">Uncategorised spending</string>
    <string name="budgets_uncategorised_body">Not counted toward any budget — these transactions have no category yet.</string>
    <string name="budgets_uncategorised_action">Set up rules</string>

    <string name="budgets_delete_title">Delete the %1$s budget?</string>
    <string name="budgets_delete_body">Your transactions are untouched. Only the limit for this month goes.</string>
    <string name="budgets_delete_confirm">Delete</string>
